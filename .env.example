# --- AI Server ---
DEVICE=cpu                        # cpu | cuda
WHISPER_MODEL_SIZE=base           # tiny | base | small | medium | large
HF_TOKEN=                         # HuggingFace token (optional, for private models)

# --- AWS ---
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
S3_BUCKET_NAME=capstone-audio-bucket
DYNAMODB_TABLE=counseling-sessions

# --- Backend ---
PORT=3000
NODE_ENV=development
USE_LOCAL=true                    # true: 로컬 파일시스템+JSON / false: AWS S3+DynamoDB

# --- LLM (치료 동맹 균열 감지) ---
LLM_PROVIDER=ollama               # ollama (로컬 무료) | gemini (무료 tier) | claude (유료)
ENABLE_RUPTURE_DETECTION=false    # true 로 설정하면 분석 완료 후 자동으로 rupture 감지 실행

# Ollama (호스트에서 `ollama serve` 필요, 모델 미리 pull 필요)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b          # qwen2.5:14b / qwen2.5:32b-instruct-q4_K_M / llama3.3:70b-q4 등

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (https://console.anthropic.com, 결제 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
