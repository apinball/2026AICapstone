# EC2 배포용 .env 템플릿
# EC2에서 `cp .env.ec2.example .env` 후 실제 IP로 수정해서 사용
#
# 구조: EC2에서는 web 컨테이너만 실행. AI 서버는 로컬 PC에서 별도 실행.
# 두 머신은 Tailscale로 연결.

# --- Tailscale 통신 (필수) ---
# 로컬 PC의 Tailscale IP (AI 서버 위치) — `tailscale ip -4` 로 확인
AI_SERVER_URL=http://100.65.91.74:8000

# EC2 자신의 Tailscale IP — `tailscale ip -4` 로 EC2 안에서 확인
# AI 서버가 callback 호출할 때 사용
SELF_INTERNAL_URL=http://100.117.253.52:3000

# --- Backend ---
PORT=3000
NODE_ENV=production
USE_LOCAL=true                    # true: EC2 로컬 디스크 사용 / false: S3+DynamoDB
ENABLE_RUPTURE_DETECTION=false    # 사용자가 버튼 클릭으로 트리거

# --- AWS (USE_LOCAL=false 일 때만 필요) ---
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=capstone-audio-bucket
# DYNAMODB_TABLE=counseling-sessions
